# Copie para a raiz do projeto na VPS como `.env`:
#   cp deploy/env.production.example .env

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Domínio público (sem https://). Usado no QR code do controle.
PUBLIC_HOST=jogo.seudominio.com
PUBLIC_PROTOCOL=https

# Alternativa: URL completa (sobrescreve PUBLIC_HOST + PUBLIC_PROTOCOL)
# PUBLIC_URL=https://jogo.seudominio.com

TRUST_PROXY=true
ALLOW_NON_LAN=true
SESSION_TTL_MINUTES=30
