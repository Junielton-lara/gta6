# ---- Dev local (notebook + TV/celular na mesma Wi-Fi) ----
PORT=3000
HOST=0.0.0.0
SESSION_TTL_MINUTES=15
ALLOW_NON_LAN=false
TRUST_PROXY=false
API_ONLY=false

# Deixe vazio: QR usa IP da LAN automaticamente.
APP_URL=
API_URL=
PUBLIC_HOST=
PUBLIC_PROTOCOL=
PUBLIC_URL=
CORS_ORIGINS=

